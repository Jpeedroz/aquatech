# AquaSmart - variáveis do Docker Compose (modelo)
# 1) Copie para ".env" na RAIZ do projeto:   cp .env.docker.example .env      (Windows: copy .env.docker.example .env)
# 2) Troque os valores "troque-...". O ".env" NÃO vai para o GitHub.

# Senha do PostgreSQL (vale para o banco criado pelo Docker)
DB_PASSWORD=troque-pela-senha-do-banco
DB_NAME=aquatech
DB_USER=postgres

# Dois segredos DIFERENTES, com 32+ caracteres. Gere cada um com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
CHAVE_DISPOSITIVOS=troque-por-outra-chave-longa-e-aleatoria

# true = cria o usuário usuario@exemplo.com / 123456 (só desenvolvimento/demonstração)
CRIAR_USUARIO_DEMO=true

# console = o e-mail (recuperação de senha) aparece nos logs do contêiner; smtp exige as variáveis SMTP_* (ver backend/.env.example)
EMAIL_MODO=console
URL_SITE=http://localhost:5000
