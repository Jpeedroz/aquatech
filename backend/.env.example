# ============================================================
# AquaSmart - configuração do back-end (modelo)
#
# 1) Copie este arquivo para ".env" (na mesma pasta):  copy .env.example .env
# 2) Troque TODOS os valores "troque-...". O ".env" NÃO vai para o GitHub.
# ============================================================

# ---- Segurança -------------------------------------------------
# Assina o cookie de login e os tokens temporários. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Segredo usado para gerar a chave de cada ESP32 (veja o README). Gere outra, diferente da anterior.
CHAVE_DISPOSITIVOS=troque-por-outra-chave-longa-e-aleatoria

# ---- PostgreSQL ------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquatech
DB_USER=postgres
DB_PASSWORD=troque-pela-senha-do-seu-postgres

# ---- Servidor --------------------------------------------------
# Endereço onde o Flask escuta. 127.0.0.1 = só este computador.
# Para o ESP32 acessar pela rede Wi-Fi use 0.0.0.0 (e libere a porta no firewall).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Endereço público do site (usado nos links enviados por e-mail)
URL_SITE=http://localhost:5000

# Origens autorizadas a chamar a API a partir de OUTRO endereço
# (ex.: front-end aberto pelo Live Server do VS Code). Separe por vírgula.
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500

# true somente quando o site estiver em HTTPS
COOKIE_SEGURO=false


# ---- E-mail (recuperação de senha e troca de e-mail) -----------
# console = NÃO envia nada: o e-mail aparece no terminal do servidor (bom para desenvolvimento)
# smtp    = envia de verdade usando os dados abaixo
EMAIL_MODO=console
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# starttls (porta 587) ou ssl (porta 465)
SMTP_SEGURANCA=starttls
